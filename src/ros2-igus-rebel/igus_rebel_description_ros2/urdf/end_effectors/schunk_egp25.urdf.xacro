<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="schunk_gripper">

    <material name="effecteur_color">
      <color rgba="0.2 0.6 0.8 1.0"/>
    </material>

    <!-- Joint fixe entre la bride du bras (flange) et l'effecteur -->
    <joint name="joint_flange_effecteur" type="fixed">
      <parent link="flange"/>
      <child link="effecteur_simplifie_link"/>
      <!-- Décaler en Z si le STL a son origine à sa base (ajuster selon le mesh) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="effecteur_simplifie_link">

      <visual>
        <!-- STL en mm : X[-75,0] Y[0,155] Z[-30,0]
             Le flange a rpy="0 -pi/2 0" → son axe X pointe vers le haut (= Z de link_8).
             Rz(-90°) : STL-Y(hauteur 155mm) → link-X (vers le haut) ✓
             xyz : recentre Y (37.5mm) et Z (15mm) après rotation -->
        <origin xyz="0 -0.0375 0.015" rpy="0 0 -1.5708"/>
        <geometry>
          <mesh filename="package://igus_rebel_description_ros2/meshes/end_effectors/effecteur_simplifie.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="effecteur_color"/>
      </visual>

      <!-- Boîte de collision : 155mm(X) x 75mm(Y) x 30mm(Z), centrée à mi-hauteur -->
      <collision>
        <origin xyz="0.0775 0 0.015" rpy="0 0 0"/>
        <geometry>
          <box size="0.155 0.075 0.030"/>
        </geometry>
      </collision>

      <!-- Inertie d'un parallélépipède 155x75x30mm, masse 0.5kg -->
      <inertial>
        <origin xyz="0.0775 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="2.72e-4" ixy="0" ixz="0"
                 iyy="1.24e-3" iyz="0"
                 izz="1.04e-3"/>
      </inertial>

    </link>

    <!-- TCP (Tool Center Point) : bout physique de la pince.
         Offset de 0.185 m le long de l'axe X de l'effecteur (axe d'outil).
         Ajuster TOOL_LENGTH_M si la pince est remplacée. -->
    <xacro:property name="TOOL_LENGTH_M" value="0.185"/>

    <joint name="joint_effecteur_tip" type="fixed">
      <parent link="effecteur_simplifie_link"/>
      <child link="gripper_tip_link"/>
      <origin xyz="${TOOL_LENGTH_M} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="gripper_tip_link"/>

  </xacro:macro>
</robot>