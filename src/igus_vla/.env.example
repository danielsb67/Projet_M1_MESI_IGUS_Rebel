# ============================================================
# Fichier d'exemple — copier en .env et remplir les valeurs
# NE PAS commiter le vrai .env (contient des secrets)
# ============================================================

# Hugging Face — token d'accès pour push_to_hub (optionnel)
HF_TOKEN=

# Adresse IP du robot réel igus ReBeL (backend=cri)
ROBOT_IP=192.168.3.11

# Port TCP du protocole CRI
ROBOT_PORT=3920

